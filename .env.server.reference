# Tracked server environment reference for local development.
# Copy the values you need into .env.server.local and keep real secrets there.
# .env.server.local is gitignored and is loaded automatically by ./run-server.sh.
#
# For Cloud Run deployments, prefer the environment-specific references:
# - .env.server.dev.reference -> .env.server.dev.local
# - .env.server.staging.reference -> .env.server.staging.local
# - .env.server.production.reference -> .env.server.production.local
# On macOS you can discover JAVA_HOME with: /usr/libexec/java_home
# JAVA_HOME=/path/to/your/java/home

PROJECT_ID=
DATABASE_URL=postgresql://YOUR_USER:YOUR_PASSWORD@localhost:5432/kaze_dev?sslmode=disable
KAZE_ENV=development
KAZE_DB_SCHEMA_MODE=none
KAZE_DB_MAXIMUM_POOL_SIZE=5
KAZE_JWT_SECRET=replace-with-a-long-random-secret
KAZE_JWT_REQUIRE_FOR_API=true
KAZE_API_TOKEN=
KAZE_CORS_ALLOWED_HOSTS=localhost:8080,127.0.0.1:8080,10.0.2.2:8080
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8080/api/v1/auth/google/callback
APPLE_SERVICE_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY_PEM=
APPLE_REDIRECT_URI=http://localhost:8080/api/v1/auth/apple/callback
KAZE_APPLE_CLIENT_IDS=
SYNC_CLOUD_ON_RUN=0
