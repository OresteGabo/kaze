# Tracked reference for the staging Cloud Run environment.
# Copy to .env.server.staging.local and keep real secrets in the local file only.

DEPLOY_ENV=staging
PROJECT_ID=kaze-backend-staging
SERVICE_NAME=kaze-api-staging
REGION=europe-west1
DATABASE_URL=postgresql://YOUR_USER:YOUR_PASSWORD@YOUR_STAGING_NEON_HOST/YOUR_STAGING_DB?sslmode=require
KAZE_DB_SCHEMA_MODE=none
KAZE_DB_MAXIMUM_POOL_SIZE=5
KAZE_JWT_SECRET=replace-with-a-long-random-staging-secret
KAZE_JWT_REQUIRE_FOR_API=true
KAZE_API_TOKEN=
KAZE_CORS_ALLOWED_HOSTS=staging.api.kazerwanda.com
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://staging.api.kazerwanda.com/api/v1/auth/google/callback
APPLE_SERVICE_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY_PEM=
APPLE_REDIRECT_URI=https://staging.api.kazerwanda.com/api/v1/auth/apple/callback
KAZE_APPLE_CLIENT_IDS=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_REDIRECT_URI=https://staging.api.kazerwanda.com/api/v1/auth/facebook/callback
CLOUD_RUN_MIN_INSTANCES=0
CLOUD_RUN_MAX_INSTANCES=4
CLOUD_RUN_CONCURRENCY=30
